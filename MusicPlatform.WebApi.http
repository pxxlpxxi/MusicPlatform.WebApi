@MusicPlatform.WebApi_HostAddress = http://localhost:5193

GET {{MusicPlatform.WebApi_HostAddress}}/
Accept: application/json

###
POST http://localhost:5193/api/songs
Content-Type: application/json

{
  "title": "API Test Song",
  "mainArtist": "API Test Artist",
  "featuredArtists": [
    "Featured Artist"
  ],
  "albums": [
    {
      "title": "API Test Album",
      "releaseDate": "2026-09-30"
    }
  ],
  "media": [
    {
      "type": "YouTube",
